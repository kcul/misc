variable "profile" {
  description = "AWS profile"
  type = string
  default = "default"
}

variable "ssh_allowed_cidrs" {
  description = "CIDR blocks allowed to SSH into the instance and connect via Mosh"
  type        = list(string)
  default     = ["27.155.210.128/32"]
}

variable "v2ray_port" {
  description = "Port the v2ray/xray server listens on"
  type        = number
  default     = 443
}

variable "xray_uuid" {
  description = "VLESS user UUID — set in terraform.tfvars (gitignored), keep stable so rebuilt instances match existing client configs"
  type        = string
  sensitive   = true
}

variable "reality_dest" {
  description = "TLS 1.3 destination REALITY masquerades as (host:port); clients send the host part as SNI"
  type        = string
  default     = "gateway.icloud.com:443"
}

