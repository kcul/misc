MIME-Version: 1.0
Content-Type: text/x-shellscript
Content-Disposition: attachment; filename="install-xray.sh"

#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/user-data.log) 2>&1

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }

# -----------------------------------------------------------------------------
# Write and run Xray Reality installer
# -----------------------------------------------------------------------------
log "Writing Xray Reality installer"
cat > /opt/install-xray-reality-al2023.sh <<'INSTALLER'
${install_script}
INSTALLER

chmod +x /opt/install-xray-reality-al2023.sh

export XRAY_PORT="${port}"
export XRAY_UUID="${uuid}"
export REALITY_DEST="${dest}"
export REALITY_SNI="${sni}"
export OPEN_FIREWALL="true"

log "Running Xray Reality installer"
bash /opt/install-xray-reality-al2023.sh >> /var/log/xray-install.log 2>&1
log "Xray Reality installation complete"

--===============XRAY_REALITY_SCRIPT==--
